{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for the main window and the always-on-top race overlay window",
  "windows": [
    "main",
    "overlay"
  ],
  "permissions": [
    "core:default",
    "core:window:allow-set-always-on-top",
    "opener:default",
    "fs:default",
    "fs:allow-write-text-file",
    "dialog:default",
    "notification:default"
  ]
}