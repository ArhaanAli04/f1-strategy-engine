# ---- builder: install all deps into a venv ----
FROM python:3.11-slim AS builder

WORKDIR /build

RUN python -m venv /venv
ENV PATH="/venv/bin:$PATH"

RUN pip install --no-cache-dir --upgrade pip hatchling

COPY pyproject.toml README.md ./
# Stub package lets hatchling resolve deps without the full source tree
RUN mkdir -p backend && touch backend/__init__.py
RUN pip install --no-cache-dir ".[dev]"

# ---- final: lean runtime image ----
FROM python:3.11-slim AS final

# libgomp1: OpenMP runtime lightgbm dlopen()s at import time
RUN apt-get update && apt-get install -y --no-install-recommends libgomp1 \
    && rm -rf /var/lib/apt/lists/*

RUN groupadd --system f1 && useradd --system --gid f1 --create-home f1

WORKDIR /app

COPY --from=builder /venv /venv
ENV PATH="/venv/bin:$PATH"
# backend.main:app resolves to /app/backend/main.py
ENV PYTHONPATH=/app

COPY backend/ ./backend/

# FASTF1_CACHE_DIR (/tmp/fastf1_cache) is a named volume (see docker-compose.yml).
# Docker copies this dir's ownership into an empty volume on first mount, so
# pre-creating it as f1:f1 here is what lets the non-root runtime user write
# FastF1's SQLite request cache — without it, replay_pipeline.py /
# ingest_live_session.py crash with "sqlite3.OperationalError: unable to open
# database file" on a root-owned volume mount.
RUN mkdir -p /tmp/fastf1_cache && chown f1:f1 /tmp/fastf1_cache

# Numba's compiled code ships in the image instead of being rebuilt on every
# boot (umap's pynndescent alone is ~50 CPU-seconds cold; see
# backend/scripts/warm_numba_cache.py). NUMBA_CPU_NAME=generic makes the cache
# valid on any x86-64 CPU, not just the build machine's. Owned by f1 so Numba
# can still add entries at run time (e.g. when docker-compose mounts newer
# source over /app/backend).
ENV NUMBA_CACHE_DIR=/app/numba_cache \
    NUMBA_CPU_NAME=generic
RUN mkdir -p /app/numba_cache && chown f1:f1 /app/numba_cache

USER f1

RUN python -m backend.scripts.warm_numba_cache

HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
    CMD python -c "import urllib.request; urllib.request.urlopen('http://localhost:8000/health')"

EXPOSE 8000

CMD ["uvicorn", "backend.main:app", "--host", "0.0.0.0", "--port", "8000"]
