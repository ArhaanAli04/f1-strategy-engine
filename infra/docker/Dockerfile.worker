# ---- builder: install all deps into a venv ----
FROM python:3.11-slim AS builder

WORKDIR /build

RUN python -m venv /venv
ENV PATH="/venv/bin:$PATH"

RUN pip install --no-cache-dir --upgrade pip hatchling

COPY pyproject.toml README.md ./
# Stub package lets hatchling resolve deps without the full source tree
RUN mkdir -p backend && touch backend/__init__.py
RUN pip install --no-cache-dir ".[dev]"

# ---- final: lean runtime image ----
FROM python:3.11-slim AS final

# libgomp1: OpenMP runtime lightgbm dlopen()s at import time
RUN apt-get update && apt-get install -y --no-install-recommends libgomp1 \
    && rm -rf /var/lib/apt/lists/*

RUN groupadd --system f1 && useradd --system --gid f1 --create-home f1

WORKDIR /app

COPY --from=builder /venv /venv
ENV PATH="/venv/bin:$PATH"
# backend.workers.celery_app resolves to /app/backend/workers/celery_app.py
ENV PYTHONPATH=/app

COPY backend/ ./backend/

# FASTF1_CACHE_DIR (/tmp/fastf1_cache) is a named volume (see docker-compose.yml).
# Docker copies this dir's ownership into an empty volume on first mount, so
# pre-creating it as f1:f1 here is what lets the non-root runtime user write
# FastF1's SQLite request cache — without it, ingest_live_session.py (auto race
# detection) / replay_pipeline.py crash with "sqlite3.OperationalError: unable
# to open database file" on a root-owned volume mount.
RUN mkdir -p /tmp/fastf1_cache && chown f1:f1 /tmp/fastf1_cache

USER f1

# --pool=solo: no forked child processes, so the single in-process Prometheus
# registry (metrics server started in celery_app.py) stays consistent — see
# CLAUDE.md's Day 12 note on why prefork's forked children would otherwise
# each get an isolated, broken copy of the metrics registry. Concurrency is
# achieved by running multiple worker pods/containers, not intra-process
# forking (matches CLAUDE.md's stated race-day scaling model).
CMD ["celery", "-A", "backend.workers.celery_app", "worker", "--loglevel=info", \
     "--pool=solo", "-Q", "telemetry_queue,prediction_queue,alert_queue"]
