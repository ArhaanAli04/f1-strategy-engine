# Database (TimescaleDB extension is installed but unused — see
# docs/architecture.md's "PostgreSQL over TimescaleDB" decision; both URLs
# point at the same plain Postgres DB)
DATABASE_URL=postgresql+asyncpg://f1user:f1pass@localhost:5432/f1db
TIMESCALE_URL=postgresql+asyncpg://f1user:f1pass@localhost:5432/f1db

# SQLAlchemy async engine pool sizing (core/config.py's DatabaseSettings).
# Defaults below match local dev; docker-compose.yml's backend service
# overrides these higher (20/40) — see CLAUDE.md's "DB connection pool
# exhaustion" note for why.
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20

# Cache
REDIS_URL=redis://default:@localhost:6379

# Security — generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-to-a-256-bit-random-hex-string

# JWT settings (core/config.py's AuthSettings) — defaults below match what
# the app uses if these are left unset.
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# FastF1 telemetry cache directory
FASTF1_CACHE_DIR=/tmp/fastf1_cache

# Local disk cache for ML models downloaded from S3 (services load lazily
# on first use per worker process — see CLAUDE.md's ML Model Registry)
MODEL_CACHE_DIR=/tmp/f1_models

# F1's live timing feed requires an F1TV Access/Pro/Premium subscription and
# a one-time interactive browser auth (see fastf1.internals.f1auth). Leave
# false for unauthenticated/best-effort live data until that's set up.
F1TV_AUTHENTICATED=false

# Observability (leave blank to disable)
SENTRY_DSN=
RELEASE_VERSION=0.1.0                # Sentry release tag — bump per deploy

# /metrics HTTP Basic Auth — defaults below match core/config.py's AppSettings
# local-dev defaults (works out of the box). Replace via GitHub Secrets on
# Day 19; must stay in sync with infra/monitoring/prometheus.yml's
# f1-backend scrape job basic_auth block.
# /metrics HTTP Basic Auth — EXAMPLE VALUES ONLY, not real credentials
# Change these in your actual .env file
METRICS_USER=metrics
METRICS_PASSWORD=metrics-dev

# Grafana admin login (localhost:3000) — local dev default, see GRAFANA_ADMIN_PASSWORD
# note in infra/docker/docker-compose.yml. Replace via GitHub Secrets on Day 19.
GRAFANA_ADMIN_PASSWORD=admin

# Alertmanager — Slack webhook URLs
SLACK_WEBHOOK_CRITICAL=              # hooks.slack.com/services/... → #alerts-critical
SLACK_WEBHOOK_WARNING=               # hooks.slack.com/services/... → #alerts-warning

# Alertmanager — PagerDuty integration key for the PodRestartsHigh alert.
# Inert until both this is set AND a Kubernetes cluster feeds
# kube-state-metrics (Day 22) — see infra/monitoring/alerts.yml.
PAGERDUTY_INTEGRATION_KEY=

# AWS S3 — model artifact storage
AWS_BUCKET_NAME=f1-strategy-models
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=ap-south-1

# Push notifications (Firebase Cloud Messaging)
FCM_SERVER_KEY=
FIREBASE_CREDENTIALS_PATH=          # path to service account JSON — never commit this file

# Runtime environment
ENVIRONMENT=development

# CORS — comma-separated allowlist of origins allowed to call the API.
# "*" (default) is fine for local dev but is rejected by browsers once
# allow_credentials=True is set, so it's only meaningful in development.
# Production example:
# ALLOWED_ORIGINS=https://f1-strategy.vercel.app,https://app.f1strategy.com
ALLOWED_ORIGINS=*

# --- Cloud DB/cache (production only — NOT read by the app itself) ---
# DATABASE_URL/TIMESCALE_URL/REDIS_URL above point at docker-compose's local
# Postgres/Redis and are what the backend/worker containers actually use.
# The three vars below are separate — infra/k8s/create-secrets.sh reads
# these directly from .env to build the Kubernetes Secret for a real
# Supabase/Upstash deployment (see CLAUDE.md's Day 24 notes on this exact
# local-vs-cloud URL confusion). Leave blank for local-only development.
#
# Supabase transaction-mode pooler (port 6543) — used for the app's
# runtime connection (backend/worker), built into DATABASE_URL by
# create-secrets.sh with the postgresql+asyncpg:// scheme swap.
SUPABASE_DATABASE_URL=
# Supabase session-mode pooler (port 5432, same pooler host as
# SUPABASE_DATABASE_URL — the true direct db.xxx.supabase.co host is
# IPv6-only and unreachable from GitHub's IPv4-only runners) — used for
# Alembic migrations only (cd.yml's migrate job), since the transaction-mode
# pooler above doesn't support the session-level features (advisory
# locks/prepared statements) a migration needs.
SUPABASE_DIRECT_URL=
# Upstash Redis — production cache/Celery broker, built into REDIS_URL by
# create-secrets.sh. Use the rediss:// (TLS) URL from the Upstash console.
UPSTASH_REDIS_URL=
